#include "scheduler.h"

/* Danh sach Task */
static sTask SCH_tasks_G[SCH_MAX_TASKS];

/* So luong Task hien tai */
static uint8_t SCH_tasks_Count = 0;

/* ID tiep theo */
static uint32_t SCH_next_ID = 0;


/* Ham noi bo: chen Task vao Delta Queue */
static uint8_t SCH_Insert_Task(sTask task, uint32_t delay)
{
    if (SCH_tasks_Count >= SCH_MAX_TASKS)
        return 0;

    uint32_t remaining = delay;
    uint8_t i = 0;

    /*
     * Tim vi tri chen.
     * Delay cua moi Task la khoang cach thoi gian
     * so voi Task dung ngay truoc no.
     */
    while (i < SCH_tasks_Count &&
           remaining >= SCH_tasks_G[i].Delay)
    {
        remaining -= SCH_tasks_G[i].Delay;
        i++;
    }

    /* Dich cac Task sang phai */
    for (uint8_t j = SCH_tasks_Count; j > i; j--)
    {
        SCH_tasks_G[j] = SCH_tasks_G[j - 1];
    }

    /* Chen Task moi */
    task.Delay = remaining;
    task.RunMe = 0;

    if (i < SCH_tasks_Count)
    {
        SCH_tasks_G[i + 1].Delay =
            SCH_tasks_G[i + 1].Delay - remaining;
    }

    SCH_tasks_G[i] = task;
    SCH_tasks_Count++;

    return 1;
}


/* Khoi tao Scheduler */
void SCH_Init(void)
{
    SCH_tasks_Count = 0;
    SCH_next_ID = 0;

    for (uint8_t i = 0; i < SCH_MAX_TASKS; i++)
    {
        SCH_tasks_G[i].pTask = 0;
        SCH_tasks_G[i].Delay = 0;
        SCH_tasks_G[i].Period = 0;
        SCH_tasks_G[i].RunMe = 0;
        SCH_tasks_G[i].TaskID = 0;
    }
}


/* Cap nhat thoi gian - goi trong Timer Interrupt */
void SCH_Update(void)
{
    if (SCH_tasks_Count == 0)
        return;

    /* Chi can giam Delay cua Task dau tien */
    if (SCH_tasks_G[0].Delay > 0)
    {
        SCH_tasks_G[0].Delay--;
    }

    /* Danh dau cac Task da den thoi diem chay */
    for (uint8_t i = 0;
         i < SCH_tasks_Count && SCH_tasks_G[i].Delay == 0;
         i++)
    {
        SCH_tasks_G[i].RunMe = 1;
    }
}


/* Thuc thi cac Task da den han */
void SCH_Dispatch_Tasks(void)
{
    while (SCH_tasks_Count > 0 &&
           SCH_tasks_G[0].RunMe == 1)
    {
        /* Luu Task dau tien */
        sTask currentTask = SCH_tasks_G[0];

        /* Xoa Task khoi danh sach */
        for (uint8_t i = 0; i < SCH_tasks_Count - 1; i++)
        {
            SCH_tasks_G[i] = SCH_tasks_G[i + 1];
        }

        SCH_tasks_Count--;

        /* Neu la Task dinh ky, them lai vao hang doi */
        if (currentTask.Period > 0)
        {
            SCH_Insert_Task(currentTask, currentTask.Period);
        }

        /* Goi ham callback */
        if (currentTask.pTask != 0)
        {
            currentTask.pTask();
        }
    }
}


/* Them Task moi */
uint32_t SCH_Add_Task(
    void (*pFunction)(void),
    uint32_t DELAY,
    uint32_t PERIOD)
{
    if (SCH_tasks_Count >= SCH_MAX_TASKS ||
        pFunction == 0)
    {
        return UINT32_MAX;
    }

    sTask newTask;

    newTask.pTask = pFunction;
    newTask.Delay = DELAY;
    newTask.Period = PERIOD;
    newTask.RunMe = 0;
    newTask.TaskID = SCH_next_ID++;

    if (SCH_Insert_Task(newTask, DELAY) == 0)
    {
        return UINT32_MAX;
    }

    return newTask.TaskID;
}


/* Xoa Task theo ID */
uint8_t SCH_Delete_Task(uint32_t taskID)
{
    for (uint8_t i = 0; i < SCH_tasks_Count; i++)
    {
        if (SCH_tasks_G[i].TaskID == taskID)
        {
            /* Cong Delay cua Task bi xoa vao Task tiep theo */
            if (i < SCH_tasks_Count - 1)
            {
                SCH_tasks_G[i + 1].Delay +=
                    SCH_tasks_G[i].Delay;
            }

            /* Dich cac Task con lai sang trai */
            for (uint8_t j = i; j < SCH_tasks_Count - 1; j++)
            {
                SCH_tasks_G[j] = SCH_tasks_G[j + 1];
            }

            SCH_tasks_Count--;

            return 1;
        }
    }

    return 0;
}
